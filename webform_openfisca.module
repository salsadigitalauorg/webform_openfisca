<?php

/**
 * @file
 * Hook implementations for the Webform OpenFisca module.
 */

use Drupal\Core\Access\AccessResult;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\Core\Session\AccountInterface;
use Drupal\block\BlockInterface;
use Drupal\block_content\BlockContentInterface;
use Drupal\paragraphs\ParagraphInterface;

/**
 * Implements hook_webform_third_party_settings_form_alter().
 */
function webform_openfisca_webform_third_party_settings_form_alter(array &$form, FormStateInterface $form_state) : void {
  /** @var \Drupal\webform_openfisca\WebformThirdPartySettingsFormAlter $alter_service */
  $alter_service = \Drupal::service('webform_openfisca.webform_form_alter.third_party_settings');
  $alter_service->alterForm($form, $form_state);
}

/**
 * Implements hook_form_FORM_ID_alter() for webform_ui_element_form.
 */
function webform_openfisca_form_webform_ui_element_form_alter(array &$form, FormStateInterface $form_state, string $form_id) : void {
  /** @var \Drupal\webform_openfisca\WebformUiElementFormAlter $alter_service */
  $alter_service = \Drupal::service('webform_openfisca.webform_form_alter.ui_element');
  $alter_service->alterForm($form, $form_state);
}

/**
 * Implements hook_help().
 */
function webform_openfisca_help(string $route_name, RouteMatchInterface $route_match) : string {
  if ($route_name === 'help.page.webform_openfisca') {
    $token_tree = \Drupal::service('token.tree_builder')->buildRenderable(['webform_openfisca'], [
      'click_insert' => FALSE,
      'show_restricted' => TRUE,
      'show_nested' => TRUE,
      'global_types' => FALSE,
    ]);
    $output = '<h3>' . t('About') . '</h3>';
    $output .= '<p>' . t('The <a href=":project">Webform OpenFisca Integration</a> module integrates Drupal Webform functionality with the OpenFisca API, allowing for seamless communication and calculation based on OpenFisca rules.', [':project' => 'https://www.drupal.org/project/webform_openfisca']) . '</p>';
    $output .= '<dl>';
    $output .= '<dt>' . t('The list of the currently available tokens provided by this module are shown below.') . '</dt>';
    $output .= '<dd>' . \Drupal::service('renderer')->render($token_tree) . '</dd>';
    $output .= '</dl>';
    return $output;
  }
  // @codeCoverageIgnoreStart
  return '';
  // @codeCoverageIgnoreEnd
}

/**
 * Implements hook_block_access().
 */
function webform_openfisca_block_access(BlockInterface $block, $operation, AccountInterface $account) {
  // Only control visibility when viewing blocks.
  if ($operation !== 'view') {
    return AccessResult::neutral();
  }

  // Only care about custom block content blocks.
  if (!str_starts_with($block->getPluginId(), 'block_content:')) {
    return AccessResult::neutral();
  }

  [, $uuid] = explode(':', $block->getPluginId(), 2);

  $blocks = \Drupal::entityTypeManager()
    ->getStorage('block_content')
    ->loadByProperties(['uuid' => $uuid]);

  /** @var \Drupal\block_content\BlockContentInterface|null $block_content */
  $block_content = reset($blocks);

  if (!$block_content instanceof BlockContentInterface) {
    return AccessResult::neutral();
  }

  /**
   * NEW CONDITION:
   * Block must reference a Paragraph of bundle "block_rac_elements".
   */
  $has_rac_paragraph = FALSE;

  foreach ($block_content->getFieldDefinitions() as $field_name => $definition) {
    // Only paragraph reference fields.
    if (
      !in_array($definition->getType(), ['entity_reference', 'entity_reference_revisions'], TRUE) ||
      $definition->getSetting('target_type') !== 'paragraph'
    ) {
      continue;
    }

    $field = $block_content->get($field_name);
    if ($field->isEmpty()) {
      continue;
    }

    foreach ($field as $item) {
      // Paragraphs use revision IDs.
      if (empty($item->target_revision_id)) {
        continue;
      }

      /** @var \Drupal\paragraphs\ParagraphInterface|null $paragraph */
      $paragraph = \Drupal::entityTypeManager()
        ->getStorage('paragraph')
        ->loadRevision($item->target_revision_id);

      if ($paragraph instanceof ParagraphInterface && $paragraph->bundle() === 'block_rac_elements') {
        $has_rac_paragraph = TRUE;
        break 2;
      }
    }
  }

  // If no matching paragraph reference, do not apply restriction.
  if (!$has_rac_paragraph) {
    return AccessResult::neutral();
  }

  $query = \Drupal::request()->query->all();
  $current_block_ids = !empty($query['blocks'])
    ? explode(',', $query['blocks'])
    : [];

  if (!in_array((string) $block_content->id(), $current_block_ids, TRUE)) {
    return AccessResult::forbidden()
      ->addCacheContexts(['url.query_args:blocks']);
  }

  return AccessResult::allowed()
    ->addCacheContexts(['url.query_args:blocks']);
}
